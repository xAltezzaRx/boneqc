# BoneQC: безопасный шаблон локальной/public-конфигурации.
# Скопируйте файл в .env и замените только значения-заглушки.
# Реальные секреты, токены, приватные адреса и медицинские данные в Git не добавляются.

BONEQC_ENVIRONMENT=development
BONEQC_LOG_LEVEL=INFO
BONEQC_API_HOST=0.0.0.0
BONEQC_API_PORT=8000

# Публикация портов на host. По умолчанию сервисы доступны только через loopback.
API_BIND_HOST=127.0.0.1
API_PORT=18080
WEB_BIND_HOST=127.0.0.1
WEB_PORT=13000
OBJECT_STORE_BIND_HOST=127.0.0.1
OBJECT_STORE_PORT=18333

# Для локального HTTP development оставьте false.
# При публикации Web через HTTPS установите true.
BONEQC_COOKIE_SECURE=false

POSTGRES_DB=boneqc
POSTGRES_USER=boneqc
POSTGRES_PASSWORD=change_me

S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_BUCKET=boneqc
S3_ENDPOINT=http://object-store:8333

# Portable default: Docker named volume.
# В конкретном deployment допускается абсолютный host path вне Git.
OBJECT_STORE_DATA_PATH=boneqc-object-store-data

REDIS_URL=redis://redis:6379/0

# Публичный demo-режим.
# mock НЕ запускает Frozen C7 и не должен выдаваться за результат конкурсной модели.
AI_PROVIDER=mock

REMOTE_AI_URL=http://ai-engine:9000
REMOTE_AI_TIMEOUT_SECONDS=30
REMOTE_AI_TOKEN=

# Frozen C7. Эти параметры используются только при AI_PROVIDER=c7.
C7_GATEWAY_URL=http://host.docker.internal:19081
C7_GATEWAY_TIMEOUT_SECONDS=180
C7_FALLBACK_ENABLED=false
C7_FALLBACK_GATEWAY_URL=http://host.docker.internal:19082

# В public/mock режиме C7 token не используется.
# Для реального C7 укажите путь к host-файлу токена, который хранится вне Git.
BONEQC_C7_GATEWAY_TOKEN_PATH=/dev/null

# Дополнительный GID для read-only secret mount.
BONEQC_SECRETS_GID=65534

# Опциональный Compose profile c7.
# Включение: docker compose --profile c7 ...
C7_BRIDGE_LISTEN_HOST=127.0.0.1
C7_BRIDGE_LISTEN_PORT=19081
C7_BRIDGE_TARGET_HOST=127.0.0.1
C7_BRIDGE_TARGET_PORT=19080

BONEQC_NETWORK_NAME=boneqc-dev

# Обязательные security placeholders. Перед запуском замените их своими случайными значениями.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
PSEUDONYM_SECRET=replace-with-64-random-hex-characters

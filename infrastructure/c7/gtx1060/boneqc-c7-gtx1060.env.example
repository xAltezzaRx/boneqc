# Шаблон environment-файла для GTX 1060 fallback gateway.
# Пример целевого пути: /etc/boneqc/c7-gtx1060.env
# Реальный token-файл и deployment-specific значения должны храниться вне Git.

BONEQC_GATEWAY_HOST=127.0.0.1
BONEQC_GATEWAY_PORT=19082

BONEQC_C7_IMAGE=boneqc-c7-compat:gtx1060-v1

BONEQC_GATEWAY_TOKEN_FILE=/etc/boneqc/secrets/c7-gateway.token
BONEQC_GATEWAY_TIMEOUT_SECONDS=3600

BONEQC_GPU_GUARD_ENABLED=true
BONEQC_GPU_LOCK_FILE=/run/boneqc-gpu/gtx1060.lock
BONEQC_GPU_PRIORITY_FILE=/run/boneqc-gpu/boneqc-priority
BONEQC_GPU_LOCK_TIMEOUT_SECONDS=120
BONEQC_GPU_MIN_FREE_MIB=3072
